# Zone-Aware Mango Soil Intelligence and Yield Gap Decision Support System
# Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Environment mode
ENVIRONMENT=development
# Options: development, production, test

# Debug mode
DEBUG=true
# Set to false in production

# ============================================================================
# API CONFIGURATION
# ============================================================================

# FastAPI Backend URL
DSS_API_URL=http://127.0.0.1:8000
# Change to your deployed URL in production

# API Port
API_PORT=8000

# API Host
API_HOST=0.0.0.0

# ============================================================================
# STREAMLIT FRONTEND
# ============================================================================

# Streamlit Port
STREAMLIT_PORT=8501

# Streamlit Server Address
STREAMLIT_SERVER_ADDRESS=localhost

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================

# Model Directory
MODEL_DIR=outputs/models

# Use Champion Models
USE_CHAMPION_MODELS=true

# Model Cache TTL (seconds)
MODEL_CACHE_TTL=3600

# ============================================================================
# DATA CONFIGURATION
# ============================================================================

# Raw Data Path
RAW_DATA_PATH=data/raw/mango_microbiome_dataset.csv

# Processed Data Path
PROCESSED_DATA_PATH=data/processed

# Feature Selection Path
SELECTED_FEATURES_JSON=data/processed/selected_features.json

# ============================================================================
# LOGGING
# ============================================================================

# Log Level
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Log File Path
LOG_FILE=logs/dss.log

# Enable File Logging
LOG_TO_FILE=false

# ============================================================================
# ZONE INTELLIGENCE (Future)
# ============================================================================

# Enable Zone Intelligence Features
ENABLE_ZONE_INTELLIGENCE=false
# Set to true after zone intelligence module is implemented

# Minimum Comparable Orchards
MIN_COMPARABLE_ORCHARDS=5

# Reference Yield Percentile
REFERENCE_YIELD_PERCENTILE=75
# Options: 50 (median), 75 (Q3), 90 (top 10%)

# ============================================================================
# SECURITY (Production Only)
# ============================================================================

# API Key (if authentication enabled)
# API_KEY=your-secret-api-key-here

# JWT Secret Key (if JWT authentication enabled)
# JWT_SECRET_KEY=your-jwt-secret-key-here

# CORS Allowed Origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================================================
# DATABASE (Future - if needed)
# ============================================================================

# Database URL (example for PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/mango_dss

# ============================================================================
# EXTERNAL SERVICES (Future - if needed)
# ============================================================================

# Weather API Key
# WEATHER_API_KEY=your-weather-api-key

# Soil Testing Lab API
# LAB_API_KEY=your-lab-api-key

# ============================================================================
# RESEARCH & EXPERIMENTATION
# ============================================================================

# Random Seed (for reproducibility)
RANDOM_SEED=42

# Enable Experiment Tracking
ENABLE_MLFLOW=false

# MLflow Tracking URI
# MLFLOW_TRACKING_URI=http://localhost:5000

# ============================================================================
# PERFORMANCE
# ============================================================================

# Number of CPU cores for parallel processing
# N_JOBS=-1 means use all available cores
N_JOBS=-1

# Max Workers for Concurrent Requests
MAX_WORKERS=4

# Request Timeout (seconds)
REQUEST_TIMEOUT=60

# ============================================================================
# FEATURE FLAGS (Future)
# ============================================================================

# Enable Real-Time Validation
ENABLE_REAL_TIME_VALIDATION=false

# Enable Intervention Tracking
ENABLE_INTERVENTION_TRACKING=false

# Enable Multi-Orchard Comparison
ENABLE_BATCH_ANALYSIS=false

# ============================================================================
# NOTES
# ============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Fill in your actual values
#
# 3. NEVER commit .env to Git (it's in .gitignore)
#
# 4. For production deployment, use secure secrets management:
#    - AWS Secrets Manager
#    - HashiCorp Vault
#    - Azure Key Vault
#    - Environment variables from hosting platform
#
