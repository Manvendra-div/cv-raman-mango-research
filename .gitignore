# ============================================================================
# MACHINE LEARNING ARTIFACTS
# ============================================================================

# Trained Models (144MB total - regenerable from training scripts)
# IMPORTANT: Champion models are preserved, but large ensemble models excluded
*.joblib
*.pkl
*.pickle
*.h5
*.hdf5
*.keras
*.onnx
*.pt
*.pth
*.safetensors
*.model
*.weights

# Preserve champion model references (lightweight JSON pointers)
!**/champion_*_model.json

# MLflow / Experiment Tracking
mlruns/
mlflow-artifacts/
wandb/
.wandb/
lightning_logs/
tensorboard/
runs/

# Model checkpoints
checkpoints/
*.ckpt

# ============================================================================
# GENERATED OUTPUTS (257MB total - all regenerable)
# ============================================================================

# Predictions (97MB - regenerable from models)
outputs/predictions/**/*.csv
outputs/predictions/**/*.parquet

# Large model artifacts in outputs/
outputs/models/**/*.joblib
outputs/models/**/*.pkl

# XAI artifacts (16MB - regenerable from trained models)
# Keep directory structure but exclude large visualization files
outputs/explainability/**/*.png
outputs/explainability/**/*.pdf
outputs/explainability/**/*.html

# Preserve README files in output directories
!outputs/**/README.md

# ============================================================================
# PROCESSED DATA (90MB - regenerable from raw data)
# ============================================================================

# Processed datasets
data/processed/*.csv
data/processed/*.parquet
data/processed/*.feather

# Split datasets
data/splits/*.csv
data/splits/*.parquet

# Preserve critical processed metadata
!data/processed/data_dictionary.csv
!data/processed/selected_features.json
!data/splits/split_membership.csv

# Interim processing artifacts
data/interim/**/*.csv
data/interim/**/*.parquet

# Feature tables (large, regenerable)
data/processed/feature_table.csv
data/processed/model_ready_*.csv

# ============================================================================
# RAW DATA MANAGEMENT
# ============================================================================

# Raw dataset is preserved (20MB - original research data)
# But exclude if it becomes too large in future
# data/raw/mango_microbiome_dataset.csv

# Real field sample data (contains potential PII - always exclude)
data/raw/real_sample_dataset/*.csv
data/validation/*.csv

# Exclude real farmer data
data/raw/field_metadata/*_real.csv
data/raw/chain_of_custody/*_real.csv

